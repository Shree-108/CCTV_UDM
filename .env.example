# Copy to .env (backend) — never commit real secrets. All values are optional.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=1024
# SU_STORAGE_DIR=storage
# SU_MODELS_DIR=models
# SU_DB_PATH=storage/sightline_uniform.db

# Uniform model (defaults come from config/uniform_config.yaml — paths relative to the project root)
# SU_UNIFORM_CONFIG=config/uniform_config.yaml
# SU_UNIFORM_MODEL=models/uniform_best.pt
# SU_DEVICE=auto        # auto | cpu | cuda

# Frontend (put in .env.local): where the browser reaches the API
# NEXT_PUBLIC_API_URL=http://localhost:8010

# Which Yatrikart AI module this dashboard is (shown under the brand): uniform | litter
# NEXT_PUBLIC_APP_MODULE=uniform

# Background capture scheduler (on by default). Manual captures via the API still work when off.
# SU_CAPTURE_SCHEDULER=off

# S3 cart batches (POST /api/s3/process). Bucket default: yk-cctv-prediction. Evidence files still stay on local disk.
# SU_S3_BUCKET=yk-cctv-prediction
# AWS credentials (standard AWS variables; or use ~/.aws/credentials instead). Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
